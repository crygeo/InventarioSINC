<UserControl x:Class="Cliente.View.Model.PageTurnoV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Cliente.ViewModel.Model"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PageTurnoVM}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Cards de estadísticas -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar de turnos -->
            <RowDefinition Height="Auto" />
            <!-- Lista de turnos -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════
             CABECERA: nombre del área + estadísticas
             ═══════════════════════════════════ -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="{Binding AreaPadre.Nombre}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="25,16,0,12" />


            <UniformGrid Rows="1" Margin="8,0,8,16">

                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Empleados"
                   Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <!-- TotalGrupos: calculado en PageTurnoVM desde la caché de ServiceGrupo -->
                        <TextBlock Text="{Binding TotalEmpleados}"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>
                
                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Turnos"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <TextBlock Text="{Binding Entities.Count}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>


                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Secciones"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <!-- TotalSecciones: calculado en PageTurnoVM desde la caché de ServiceSeccion -->
                        <TextBlock Text="{Binding TotalSecciones}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>

                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Grupos"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <!-- TotalGrupos: calculado en PageTurnoVM desde la caché de ServiceGrupo -->
                        <TextBlock Text="{Binding TotalGrupos}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>

                
            </UniformGrid>
        </StackPanel>


        <!-- ═══════════════════════════════════
             TOOLBAR: título de sección + acciones
             ═══════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Turnos"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding CargarPageCommand}"
                        ToolTip="Actualizar">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding CrearEntityCommand}"
                        ToolTip="Nuevo turno">
                    <md:PackIcon Kind="Plus" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Barra de progreso de carga -->
        <ProgressBar Grid.Row="1"
                     VerticalAlignment="Bottom"
                     Height="2"
                     IsIndeterminate="False"
                     Value="{Binding ProgressValue}"
                     Visibility="{Binding ProgressVisible,
                                  Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- ═══════════════════════════════════
             LISTA DE TURNOS
             ═══════════════════════════════════ -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Entities}"
                  SelectedItem="{Binding EntitySelect}"
                  SelectionChanged="OnTurnoSelectionChanged">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"
                       BasedOn="{StaticResource MaterialDesignListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,8" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Información del turno -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nombre}"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBlock Text="{Binding IdTurnoTrabajo}" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                
                            </TextBlock>
                        </StackPanel>

                        <!-- Acciones CRUD con parámetro explícito — evita bug de EntitySelect -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Hidden"
                                    x:Name="ActionPanel">
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.EditarEntityFromItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Width="28" Height="28" Padding="0"
                                    ToolTip="Editar turno">
                                <md:PackIcon Kind="Pencil" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.EliminarEntityFromItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Width="28" Height="28" Padding="0"
                                    ToolTip="Eliminar turno">
                                <md:PackIcon Kind="Delete" Width="14" Height="14" />
                            </Button>
                        </StackPanel>

                        <!-- Drill-down → ver secciones del turno -->
                        <Button Grid.Column="2"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Tag="{Binding}"
                                Click="OnVerSeccionesClick"
                                VerticalAlignment="Center"
                                ToolTip="Ver secciones">
                            <md:PackIcon Kind="ChevronRight" />
                        </Button>
                    </Grid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver,
                                               RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                     Value="True">
                            <Setter TargetName="ActionPanel" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</UserControl>
