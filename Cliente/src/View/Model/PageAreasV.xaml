<UserControl x:Class="Cliente.View.Model.PageAreasV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Cliente.ViewModel.Model"
             xmlns:detail="clr-namespace:Cliente.ViewModel.Model.Detail"
             xmlns:detailV="clr-namespace:Cliente.View.Model.Detail"
             xmlns:obj="clr-namespace:Cliente.Obj"
             xmlns:bg="clr-namespace:Cliente.Attributes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Cliente.View.Model"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PageAreaVM}">

    <UserControl.Resources>
        <!-- DataTemplates que mapean ViewModel → Vista -->
        <DataTemplate DataType="{x:Type vm:EmptyDetailVM}">
            <TextBlock Text="Selecciona un área para ver el detalle"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       FontSize="14" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type detail:AreaDetailVM}">
            <detailV:AreaDetailV />
        </DataTemplate>

        <DataTemplate DataType="{x:Type detail:TurnoDetailVM}">
            <detailV:TurnoDetailV />
        </DataTemplate>

        <DataTemplate DataType="{x:Type detail:SeccionDetailVM}">
            <detailV:SeccionDetailV />
        </DataTemplate>

        <DataTemplate DataType="{x:Type detail:GrupoDetailVM}">
            <detailV:GrupoDetailV />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" />
            <ColumnDefinition Width="5" />    <!-- Splitter -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             PANEL IZQUIERDO — Lista de Áreas colapsable
             ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" Margin="8,4">
                <TextBlock Text="Áreas" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Actualizar">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding CrearEntityCommand}"
                        ToolTip="Nueva Área">
                    <md:PackIcon Kind="Plus" Width="18" Height="18"/>
                </Button>
            </StackPanel>

            <!-- Lista de Áreas (colapsable) -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding AreaNodes}"
                     SelectedItem="{Binding SelectedAreaNode}"
                     Style="{StaticResource MaterialDesignListBox}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type obj:AreaNode}">
                        <Expander IsExpanded="False"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Area.Nombre}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding EditCommand}"
                                                CommandParameter="{Binding Area}"
                                                Width="24" Height="24" Padding="0"
                                                ToolTip="Editar">
                                            <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DeleteCommand}"
                                                CommandParameter="{Binding Area}"
                                                Width="24" Height="24" Padding="0"
                                                ToolTip="Eliminar">
                                            <md:PackIcon Kind="Delete" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>

                            <!-- Turnos anidados -->
                            <ItemsControl ItemsSource="{Binding Children}"
                                          Margin="16,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type obj:TurnoNode}">
                                        <Expander IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Turno.Nombre}"
                                                           VerticalAlignment="Center"/>
                                            </Expander.Header>
                                            <!-- Secciones -->
                                            <ItemsControl ItemsSource="{Binding Children}"
                                                          Margin="16,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type obj:SeccionNode}">
                                                        <Expander IsExpanded="False">
                                                            <Expander.Header>
                                                                <TextBlock Text="{Binding Seccion.Nombre}"/>
                                                            </Expander.Header>
                                                            <!-- Grupos -->
                                                            <ItemsControl ItemsSource="{Binding Children}"
                                                                          Margin="16,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type obj:GrupoNode}">
                                                                        <TextBlock Text="{Binding Grupo.Nombre}"
                                                                                   Padding="4,2"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Splitter redimensionable -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ══════════════════════════════════════════════════════
             PANEL DERECHO — Detalle con navegación hacia atrás
             ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de navegación -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    Padding="8,4"
                    Visibility="{Binding DetailNavigation.CanGoBack,
                                 Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding DetailNavigation.GoBackCommand}"
                            ToolTip="Volver">
                        <md:PackIcon Kind="ArrowLeft"/>
                    </Button>
                    <TextBlock Text="Volver"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Contenido del detalle — navega por DataTemplates -->
            <ContentControl Grid.Row="1"
                            Content="{Binding DetailNavigation.Current}"
                            Margin="8"/>
        </Grid>
    </Grid>
</UserControl>