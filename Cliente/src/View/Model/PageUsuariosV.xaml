<UserControl x:Class="Cliente.View.Model.PageUsuariosV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:convert="clr-namespace:Utilidades.Converters;assembly=Utilidades"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Cliente.ViewModel.Model"
             xmlns:converter="clr-namespace:Cliente.Converter"
             xmlns:ex="clr-namespace:Cliente.Extencions"
             xmlns:items="clr-namespace:Cliente.View.Items"
             xmlns:assist="clr-namespace:Utilidades.Assist;assembly=Utilidades"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:PageUsuarioVM}">

    <UserControl.Resources>
        <ex:BindingProxyWrapper x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="8,8,8,4">
                <TextBlock Text="Usuarios"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding CargarPageCommand}"
                        ToolTip="Actualizar lista">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding CrearEntityCommand}"
                        ToolTip="Nuevo Usuario">
                    <md:PackIcon Kind="Plus" Width="18" Height="18" />
                </Button>
            </StackPanel>

            <ProgressBar Grid.Row="0"
                         VerticalAlignment="Bottom"
                         Height="2"
                         IsIndeterminate="False"
                         Value="{Binding ProgressValue}"
                         Visibility="{Binding ProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ListBox ItemsSource="{Binding Entities}"
                     SelectedItem="{Binding EntitySelect}"
                     SelectionMode="Extended"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     Grid.Row="1">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5">
                            <TextBlock Grid.Row="0" Text="{Binding Model.User}" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="{Binding Model.NombreAndApellido}" FontSize="12" Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="IsSelected" Value="{Binding Model.IsSelect, Mode=TwoWay}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu Style="{StaticResource MaterialDesignContextMenu}">
                                    <MenuItem
                                        Command="{Binding Data.EditarEntityFromItemCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding Model}" Header="_Editar"
                                        Icon="{md:PackIcon Kind=AccountEdit}" />
                                    <MenuItem
                                        Command="{Binding Data.EliminarEntityFromItemCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding Model}" Header="_Eliminar"
                                        Icon="{md:PackIcon Kind=Delete}" />
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding Data.CambiarPasswordCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding Model}" Header="_Cambiar Contraseña"
                                        Icon="{md:PackIcon Kind=FormTextboxPassword}" />
                                    <Separator />
                                    <MenuItem Header="_Roles"
                                              ItemsSource="{Binding Data.EntitySelect.Ref[Roles], Source={StaticResource Proxy}}"
                                              Icon="{md:PackIcon Kind=ShieldAccount}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Command"
                                                        Value="{Binding Data.AsignarRolCommand, Source={StaticResource Proxy}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="Header" Value="{Binding Nombre}" />
                                                <Setter Property="IsEnabled"
                                                        Value="{Binding IsAdmin, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                <Setter Property="IsCheckable" Value="False" />
                                                <Setter Property="IsChecked"
                                                        Value="{Binding IsSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Setter Property="StaysOpenOnClick" Value="True" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

            </ListBox>

        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource MaterialDesignDivider}" />

        <!--Panel Derecho-->
        <md:Card Padding="20" Margin="10" Background="{DynamicResource MaterialDesignPaper}" Grid.Column="2">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 🔹 Información principal -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    Content="{Binding EntitySelectModel.NombreCompleto}"
                                    assist:FieldAssist.Label="Nombre:"
                                    Style="{StaticResource FieldStyle}" />

                    <ContentControl Grid.Row="1" Grid.Column="0"
                                    Content="{Binding EntitySelectModel.Cedula}" assist:FieldAssist.Label="Cedula:"
                                    assist:FieldAssist.Format="Dni"
                                    Style="{StaticResource FieldStyle}" />

                    <ContentControl Grid.Row="1" Grid.Column="1"
                                    Content="{Binding EntitySelectModel.Celular}"
                                    assist:FieldAssist.Label="Celular:" assist:FieldAssist.Format="Phone"
                                    Style="{StaticResource FieldStyle}" />

                    <ContentControl Grid.Row="2" Grid.Column="0"
                                    Content="{Binding EntitySelectModel.User}"
                                    assist:FieldAssist.Label="Usuario:" assist:FieldAssist.Format="NickName"
                                    Style="{StaticResource FieldStyle}" />


                </Grid>

                <!-- 🔹 Roles -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <TextBlock Text="Roles"
                               Style="{StaticResource FieldLabel}"
                               FontSize="14"
                               FontWeight="Bold" />

                    <ItemsControl ItemsSource="{Binding EntitySelect.Ref[Roles]}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5"
                                        Padding="8,4"
                                        CornerRadius="12"
                                        Background="{DynamicResource MaterialDesignChipBackground}">

                                    <StackPanel Orientation="Horizontal">

                                        <!-- Normal -->
                                        <TextBlock Text="{Binding Nombre}"
                                                   Visibility="{Binding IsClassified, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                   Style="{StaticResource FieldValue}" />

                                        <!-- Bloqueado -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsClassified, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource FieldValue}" />
                                            <TextBlock Text=" 🔒" />
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Grid>
        </md:Card>
    </Grid>
</UserControl>