<UserControl x:Class="Cliente.View.Model.Detail.AreaDetailV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:detail="clr-namespace:Cliente.ViewModel.Model.Detail"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance detail:AreaDetailVM}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Encabezado -->
            <TextBlock Text="{Binding Area.Nombre}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="0,0,0,16" />

            <!-- Estadísticas rápidas -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Turnos" Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <TextBlock Text="{Binding Turnos.Count}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>
                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Secciones" Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <TextBlock
                            Text="{Binding Turnos, Converter={StaticResource CountNestedConverter}, ConverterParameter=Secciones}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>
                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Grupos" Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <TextBlock
                            Text="{Binding Turnos, Converter={StaticResource CountNestedConverter}, ConverterParameter=Grupos}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>
            </UniformGrid>

            <!-- Lista de Turnos -->
            <StackPanel Orientation="Horizontal" Margin="8,4">
                <TextBlock Text="Turno" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding  }"
                        ToolTip="Actualizar">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding }"
                        ToolTip="Nueva Área">
                    <md:PackIcon Kind="Plus" Width="18" Height="18" />
                </Button>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Turnos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type detail:TurnoDetailVM}">
                        <md:Card Margin="0,4" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Turno.Nombre}"
                                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                                               FontWeight="SemiBold" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{Binding Turno.HoraInicio, StringFormat=hh\\:mm}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Turno.HoraFin, StringFormat=hh\\:mm}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Secciones.Count, StringFormat='Secciones: {0}'}"
                                               FontSize="12" />
                                </StackPanel>
                                <!-- El botón navega al detalle del turno -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding EditCommand}"
                                            CommandParameter="{Binding Turno}"
                                            Width="24" Height="24" Padding="0"
                                            ToolTip="Editar">
                                        <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DeleteCommand}"
                                            CommandParameter="{Binding Turno}"
                                            Width="24" Height="24" Padding="0"
                                            ToolTip="Eliminar">
                                        <md:PackIcon Kind="Delete" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.NavigateToTurnoCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Ver detalle">
                                    <md:PackIcon Kind="ChevronRight" />
                                </Button>
                            </Grid>
                        </md:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>