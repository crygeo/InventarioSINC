<UserControl x:Class="Cliente.View.Model.Detail.TurnoDetailV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:detail="clr-namespace:Cliente.ViewModel.Model.Detail"
             xmlns:local="clr-namespace:Cliente.View.Model.Detail"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance detail:TurnoDetailVM}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Encabezado -->
            <TextBlock Text="{Binding Turno.Nombre}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="0,0,0,16"/>

            <!-- Estadísticas rápidas -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Secciones" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                        <TextBlock Text="{Binding Secciones.Count}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    </StackPanel>
                </md:Card>
                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Grupos" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                        <TextBlock Text="{Binding Secciones, Converter={StaticResource CountNestedConverter}, ConverterParameter=Grupos}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    </StackPanel>
                </md:Card>
            </UniformGrid>

            <!-- Lista de Secciones -->
            <TextBlock Text="Secciones" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                       Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding Secciones}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type detail:SeccionDetailVM}">
                        <md:Card Margin="0,4" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Seccion.Nombre}"
                                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="Cupo: "/>
                                        <Run Text="{Binding Seccion.Cupo}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="Tipo Grupo: "/>
                                        <md:PackIcon Margin="0,5,0,0" Width="16" Height="16">
                                            <md:PackIcon.Style>
                                                <Style TargetType="md:PackIcon">
                                                    <Setter Property="Kind" Value="Close"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Seccion.EsGrupo}" Value="True">
                                                            <Setter Property="Kind" Value="Check"/>
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </md:PackIcon.Style>
                                        </md:PackIcon>
                                    </TextBlock>
                                </StackPanel>
                                <!-- El botón navega al detalle del turno -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.NavigateToTurnoCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Ver detalle">
                                    <md:PackIcon Kind="ChevronRight"/>
                                </Button>
                            </Grid>
                        </md:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
