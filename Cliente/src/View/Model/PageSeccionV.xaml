<UserControl x:Class="Cliente.View.Model.PageSeccionV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Cliente.ViewModel.Model"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PageSeccionVM}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="{Binding TurnoPadre.Nombre}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="25,16,0,12" />


            <UniformGrid Rows="1" Margin="8,0,8,16">

                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Empleados"
                   Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <!-- TotalGrupos: calculado en PageTurnoVM desde la caché de ServiceGrupo -->
                        <TextBlock Text="{Binding TotalEmpleados}"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>

                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Secciones"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <TextBlock Text="{Binding Entities.Count}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>


                <md:Card Margin="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Grupos"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <!-- TotalGrupos: calculado en PageTurnoVM desde la caché de ServiceGrupo -->
                        <TextBlock Text="{Binding TotalGrupos}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </md:Card>


            </UniformGrid>
        </StackPanel>

        <!-- Encabezado -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="12,8">
            <TextBlock Text="Secciones"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <Button Style="{StaticResource MaterialDesignIconButton}"
                    Command="{Binding CargarPageCommand}"
                    ToolTip="Actualizar">
                <md:PackIcon Kind="Refresh" Width="18" Height="18" />
            </Button>
            <Button Style="{StaticResource MaterialDesignIconButton}"
                    Command="{Binding CrearEntityCommand}"
                    ToolTip="Nueva sección">
                <md:PackIcon Kind="Plus" Width="18" Height="18" />
            </Button>
        </StackPanel>

        <!-- Barra de progreso -->
        <ProgressBar Grid.Row="1"
                     VerticalAlignment="Bottom"
                     Height="2"
                     Value="{Binding ProgressValue}"
                     Visibility="{Binding ProgressVisible,
                                  Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Lista de secciones -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Entities}"
                  SelectedItem="{Binding EntitySelect}"
                  SelectionChanged="OnSeccionSelectionChanged">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"
                       BasedOn="{StaticResource MaterialDesignListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,8" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid DataContext="{Binding Model}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nombre}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CupoText"
                                           FontSize="12"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           VerticalAlignment="Top"
                                           Visibility="{Binding EsGrupo, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                           Margin="0,0,12,0">               
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Cupo: {0}/{1}">
                                            <Binding Path="EmpleadoIds.Count"/>
                                            <Binding Path="Cupo"/>
                                        </MultiBinding>
                                    </TextBlock.Text>

                                </TextBlock>

                                <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Top" >
                                    <Run Text="Tipo Grupo: "/>
                                </TextBlock>
                                <md:PackIcon Width="15" Height="15">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Kind" Value="Close" />
                                            <Setter Property="Foreground" Value="OrangeRed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsGrupo}" Value="True">
                                                    <Setter Property="Kind" Value="AccountGroup" />
                                                    <Setter Property="Foreground" Value="MediumSeaGreen" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                </md:PackIcon>
                            </StackPanel>
                        </StackPanel>

                        <!-- Acciones CRUD con parámetro explícito -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Hidden"
                                    x:Name="ActionPanel">
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.EditarEntityFromItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Width="28" Height="28" Padding="0"
                                    ToolTip="Editar sección">
                                <md:PackIcon Kind="Pencil" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.EliminarEntityFromItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Width="28" Height="28" Padding="0"
                                    ToolTip="Eliminar sección">
                                <md:PackIcon Kind="Delete" Width="14" Height="14" />
                            </Button>
                        </StackPanel>

                        <!-- Drill-down → grupos -->
                        <Button Grid.Column="2"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Tag="{Binding}"
                                Click="OnVerGruposClick"
                                VerticalAlignment="Center"
                                ToolTip="Ver grupos">
                            <md:PackIcon Kind="ChevronRight" />
                        </Button>
                    </Grid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver,
                                               RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                     Value="True">
                            <Setter TargetName="ActionPanel" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
